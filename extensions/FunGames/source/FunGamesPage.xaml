<UserControl x:Class="Osiris.Extensions.FunGames.FunGamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Osiris.Extensions.FunGames"
             Background="#090909" FontFamily="{DynamicResource FontFamily}"
             FontSize="17" FontWeight="SemiBold" Foreground="#F0F1F7"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ExtensionActions.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ContentControl x:Name="FixedHeaderHost" MinHeight="76" MaxHeight="76"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" />
        <ScrollViewer x:Name="GamesCatalog" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="GameChoices" Margin="40,40,16,16">
                <Border x:Name="RouletteCard" Width="360" Height="560" Margin="0,0,24,24"
                        Background="#070707" BorderBrush="#2B2B2B" BorderThickness="1" CornerRadius="14" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="52" />
                        </Grid.RowDefinitions>
                        <local:RouletteArtwork x:Name="WheelArtwork" IsHitTestVisible="False" ClipToBounds="True" />
                            <Button x:Name="RoulettePlayButton" Grid.Row="2" Content="Play" Height="52"
                                    Click="OnPlayRoulette"
                                    AutomationProperties.Name="Play Roulette"
                                    Style="{StaticResource FunGamesPlayButtonStyle}" />
                    </Grid>
                </Border>
            </WrapPanel>
        </ScrollViewer>
        <ContentControl x:Name="RouletteHost" Grid.Row="1" Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</UserControl>
