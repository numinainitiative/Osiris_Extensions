<UserControl x:Class="Osiris.Extensions.FunGames.RoulettePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Osiris.Extensions.FunGames" Background="#090909" Foreground="#F0F1F7"
 FontFamily="{DynamicResource FontFamily}" FontSize="17" FontWeight="SemiBold">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="RouletteControls.xaml" />
 </ResourceDictionary.MergedDictionaries>
 <Style x:Key="RouletteSpinAction" TargetType="Button" BasedOn="{StaticResource RouletteAction}">
  <Setter Property="Foreground" Value="#FFFFFF"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="SpinChrome" BorderThickness="1" BorderBrush="#8164A1" CornerRadius="10" Padding="{TemplateBinding Padding}">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#65418F" Offset="0"/><GradientStop Color="#35575C" Offset="1"/></LinearGradientBrush></Border.Background>
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SpinChrome" Property="BorderBrush" Value="#C6A0ED"/><Setter TargetName="SpinChrome" Property="Opacity" Value="0.88"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SpinChrome" Property="BorderBrush" Value="#F0DBFF"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="SpinChrome" Property="Opacity" Value="0.68"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid>
  <Grid x:Name="PlayView" Margin="40">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Grid.RowSpan="3" Margin="-40" IsHitTestVisible="False">
    <Border.Background><RadialGradientBrush Center="0.78,0.38" GradientOrigin="0.78,0.38" RadiusX="0.8" RadiusY="0.9"><GradientStop Color="#15111E" Offset="0"/><GradientStop Color="#090909" Offset="1"/></RadialGradientBrush></Border.Background>
   </Border>
   <StackPanel x:Name="OptionsPanel" Orientation="Horizontal" Margin="0,0,0,24">
    <TextBlock Text="Roulette" FontSize="28" VerticalAlignment="Center" Margin="0,0,24,0"/>
    <ComboBox x:Name="SavedList" Width="280" DisplayMemberPath="Name" SelectionChanged="OnSelectionChanged" Style="{StaticResource OsirisSettingsOutlinedComboBoxStyle}" Margin="0,0,16,0" AutomationProperties.Name="Selected roulette"/>
    <Button x:Name="ManageButton" Content="Manage Roulettes" Style="{StaticResource RouletteAction}" Click="OnManage"/>
   </StackPanel>
   <Grid x:Name="WheelArea" Grid.Row="1" MaxWidth="1400" HorizontalAlignment="Stretch" VerticalAlignment="Center">
    <Grid.RowDefinitions><RowDefinition Height="400"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <local:RouletteAtmosphere x:Name="LightShafts"/>
    <local:RouletteWheel x:Name="Wheel" Height="400" MaxWidth="1400" MaxHeight="480" MinHeight="240"/>
    <Button x:Name="SpinButton" Grid.Row="1" Content="Spin roulette" Style="{StaticResource RouletteSpinAction}" Height="52" FontSize="22" HorizontalAlignment="Right" MinWidth="260" Margin="0,20,0,0" Click="OnSpin"/>
   </Grid>
   <StackPanel x:Name="InlineResult" Visibility="Collapsed">
    <TextBlock x:Name="ResultName"/><TextBlock x:Name="ResultDescription"/>
   </StackPanel>
   <TextBlock x:Name="PageStatus" Grid.Row="2" Foreground="#A6A6A6" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
  </Grid>
  <Grid x:Name="BuilderView" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="86"/></Grid.RowDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Width="760" HorizontalAlignment="Left" Margin="40">
     <TextBlock Text="Build a roulette" FontSize="24" Margin="0,0,0,24"/>
     <TextBlock Text="Roulette name" Margin="0,0,0,8"/>
     <TextBox x:Name="RouletteName" MaxLength="80" Style="{StaticResource RouletteInput}" Margin="0,0,0,24" AutomationProperties.Name="Roulette name"/>
     <DockPanel Margin="0,0,0,12">
      <Button x:Name="AddOptionButton" DockPanel.Dock="Right" Content="Add option" Click="OnAddOption" Style="{StaticResource RouletteAction}"/>
      <TextBlock Text="Options" VerticalAlignment="Center"/>
     </DockPanel>
     <ItemsControl x:Name="OptionRows">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="#252525" BorderThickness="1" CornerRadius="7" Padding="18" Margin="0,0,0,24">
        <StackPanel>
         <DockPanel Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Content="Remove" Click="OnRemoveOption" Tag="{Binding}" Style="{StaticResource RouletteAction}"/>
          <TextBlock Text="Option name" VerticalAlignment="Center"/>
         </DockPanel>
         <TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Style="{StaticResource RouletteInput}" AutomationProperties.Name="Option name"/>
         <TextBlock Text="Description" Margin="0,12,0,8"/>
         <TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" Style="{StaticResource RouletteInput}" Height="80" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="Option description"/>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="1" BorderBrush="#242424" BorderThickness="0,1,0,0">
    <DockPanel Margin="40,0,26,0" VerticalAlignment="Center">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <Button x:Name="SaveButton" Content="Save" Style="{StaticResource RouletteAction}" Click="OnSave" Margin="0,0,10,0"/>
      <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource RouletteAction}" Click="OnCancel"/>
     </StackPanel>
     <TextBlock x:Name="BuilderStatus" Foreground="#C68B8B" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,24,0"/>
    </DockPanel>
   </Border>
  </Grid>
  <Grid x:Name="WinnerOverlay" Panel.ZIndex="100" Visibility="Collapsed" Background="#B9000000"
        KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
   <local:WinnerConfetti x:Name="Confetti" />
   <Border Width="760" MaxWidth="{Binding ActualWidth,ElementName=WinnerOverlay}" Margin="24"
           HorizontalAlignment="Center" VerticalAlignment="Center" Background="#090909"
           BorderBrush="#474747" BorderThickness="1.5" CornerRadius="10" Padding="44">
    <StackPanel>
     <TextBlock Text="Winner!" FontSize="32" Foreground="#B878FF" TextAlignment="Center"/>
     <TextBlock x:Name="WinnerName" FontSize="42" TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,0"/>
     <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,0">
      <TextBlock x:Name="WinnerDescription" FontSize="22" Foreground="#A6A6A6" TextAlignment="Center" TextWrapping="Wrap"/>
     </ScrollViewer>
     <Button x:Name="WinnerCloseButton" Content="Close" HorizontalAlignment="Center" MinWidth="140" Height="52" FontSize="22" Margin="0,32,0,0"
             Style="{StaticResource RouletteAction}" Click="OnWinnerClose"/>
    </StackPanel>
   </Border>
  </Grid>
  <Grid x:Name="DeleteOverlay" Panel.ZIndex="101" Visibility="Collapsed" Background="#B9000000" KeyboardNavigation.TabNavigation="Cycle">
   <Border Width="480" Background="#090909" BorderBrush="#474747" BorderThickness="1.5" CornerRadius="10" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel>
     <TextBlock Text="Delete roulette?" FontSize="24"/>
     <TextBlock x:Name="DeleteName" TextWrapping="Wrap" Margin="0,12,0,24"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="ConfirmDeleteButton" Content="Delete" Style="{StaticResource RouletteAction}" Click="OnConfirmDelete" Margin="0,0,10,0"/>
      <Button x:Name="CancelDeleteButton" Content="Cancel" Style="{StaticResource RouletteAction}" Click="OnCancelDelete"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</UserControl>
