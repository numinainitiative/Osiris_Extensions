<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Style x:Key="OsirisExtensionBrowsePrimaryButtonStyle" TargetType="{x:Type Button}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Height" Value="42" /><Setter Property="Padding" Value="16,0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Bottom" /><Setter Property="Foreground" Value="#F0F1F7" /><Setter Property="Background" Value="#111111" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontFamily" Value="{DynamicResource FontFamily}" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Focusable" Value="False" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="SnapsToDevicePixels" Value="True" /><Setter Property="UseLayoutRounding" Value="True" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}"><Border x:Name="BrowsePrimaryBackground" Background="{TemplateBinding Background}" CornerRadius="0,0,12,12" SnapsToDevicePixels="True" UseLayoutRounding="True"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BrowsePrimaryBackground" Property="Background" Value="#1A1A1A" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="BrowsePrimaryBackground" Property="Background" Value="#252525" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /><Setter Property="Cursor" Value="Arrow" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="OsirisExtensionBrowseInstallPrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource OsirisExtensionBrowsePrimaryButtonStyle}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Foreground" Value="#0D0D0D" /><Setter Property="Background" Value="#A8A8A8" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}"><Border x:Name="BrowseInstallPrimaryBackground" Background="{TemplateBinding Background}" CornerRadius="0,0,9,9" SnapsToDevicePixels="True" UseLayoutRounding="True"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BrowseInstallPrimaryBackground" Property="Background" Value="#F4F4F4" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="BrowseInstallPrimaryBackground" Property="Background" Value="#D7D9DE" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /><Setter Property="Cursor" Value="Arrow" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <!-- User-requested Play variant: preserve card geometry, dark until hover. -->
    <Style x:Key="FunGamesPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource OsirisExtensionBrowsePrimaryButtonStyle}">
        <Setter Property="Background" Value="#303030" />
        <Setter Property="Foreground" Value="#F0F1F7" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PlayBackground" Background="{TemplateBinding Background}" CornerRadius="0,0,9,9"
                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PlayBackground" Property="Background" Value="#FFFFFF" />
                            <Setter Property="Foreground" Value="#070707" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PlayBackground" Property="Background" Value="#D7D9DE" />
                            <Setter Property="Foreground" Value="#070707" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
