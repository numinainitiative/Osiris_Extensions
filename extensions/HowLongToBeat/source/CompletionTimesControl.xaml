<PluginUserControl x:Class="Osiris.Extensions.HowLongToBeat.CompletionTimesControl"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   Focusable="False">
    <PluginUserControl.Resources>
        <Style x:Key="TimeLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Rajdhani" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#626262" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>
        <Style x:Key="TimeValue" TargetType="TextBlock" BasedOn="{StaticResource TimeLabel}">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="TimeRow" TargetType="Border">
            <Setter Property="Background" Value="#101010" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,13" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="CompletionistLabel" TargetType="TextBlock" BasedOn="{StaticResource TimeLabel}">
            <Setter Property="Foreground" Value="#070707" />
        </Style>
        <Style x:Key="CompletionistValue" TargetType="TextBlock" BasedOn="{StaticResource TimeValue}">
            <Setter Property="Foreground" Value="#070707" />
        </Style>
    </PluginUserControl.Resources>

    <Grid>
        <StackPanel x:Name="ResultPanel">
            <Border Style="{StaticResource TimeRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MAIN STORY" Style="{StaticResource TimeLabel}" />
                    <TextBlock Grid.Column="1" Text="{Binding MainStoryText}" Style="{StaticResource TimeValue}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource TimeRow}" Background="#292929">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MAIN + EXTRAS" Style="{StaticResource TimeLabel}" />
                    <TextBlock Grid.Column="1" Text="{Binding MainExtraText}" Style="{StaticResource TimeValue}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource TimeRow}"
                    Margin="0"
                    Background="#858B94"
                    CornerRadius="0,0,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="COMPLETIONIST" Style="{StaticResource CompletionistLabel}" />
                    <TextBlock Grid.Column="1" Text="{Binding CompletionistText}" Style="{StaticResource CompletionistValue}" />
                </Grid>
            </Border>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasResult}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
        </StackPanel>

        <TextBlock Text="{Binding StatusMessage}"
                   Margin="16,15"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="{DynamicResource FontFamily}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#777A82"
                   TextAlignment="Center"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasResult}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</PluginUserControl>
