<UserControl x:Class="Osiris.Extensions.HowLongToBeat.HowLongToBeatGlobalPageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Osiris.Extensions.HowLongToBeat"
             Background="#090909"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <Style x:Key="LibraryToolbarComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="#D5D6DC" />
            <Setter Property="FontFamily" Value="Rajdhani" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBackground"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="#1A1A1A" />
                                <Setter Property="Foreground" Value="#F0F1F7" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="#1A1A1A" />
                                <Setter Property="Foreground" Value="#F0F1F7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryToolbarComboBox" TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#282828" />
            <Setter Property="Background" Value="#0B0B0B" />
            <Setter Property="Foreground" Value="#D5D6DC" />
            <Setter Property="FontFamily" Value="Rajdhani" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0,34,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource LibraryToolbarComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Height="{TemplateBinding Height}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" />
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <TextBlock Margin="0,0,14,0"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Text="&#xE70D;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Foreground="#777B84" />
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   VerticalOffset="6"
                                   Focusable="False"
                                   AllowsTransparency="True">
                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      SnapsToDevicePixels="True">
                                    <Border Background="#111111"
                                            BorderBrush="#282828"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000"
                                                              BlurRadius="14"
                                                              ShadowDepth="4"
                                                              Opacity="0.55" />
                                        </Border.Effect>
                                    </Border>
                                    <ScrollViewer Margin="4,0,0,0"
                                                  Padding="0"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="True" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#343434" />
                                <Setter Property="Foreground" Value="#F0F1F7" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryToolbarSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="44" Height="24" Background="Transparent">
                            <Border x:Name="ToggleTrack"
                                    Background="Transparent"
                                    BorderBrush="#34363D"
                                    BorderThickness="1"
                                    CornerRadius="12" />
                            <Ellipse x:Name="ToggleThumb"
                                     Width="18"
                                     Height="18"
                                     Margin="3"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Fill="#9EA0A6" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#555860" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="#1B1B1B" />
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#666666" />
                                <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="ToggleThumb" Property="Fill" Value="#F7F8FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#111111" />
            <Setter Property="BorderBrush" Value="#242424" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Foreground" Value="#777A82" />
            <Setter Property="FontFamily" Value="Rajdhani" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="LibraryRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="94" />
            <Setter Property="Background" Value="#090909" />
            <Setter Property="Foreground" Value="#F0F1F7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#0C0C0C" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#121212" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#161616" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LibraryCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#181818" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GameTitleButton" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#F0F1F7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OsirisActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#111111" />
            <Setter Property="BorderBrush" Value="#252525" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#F3F4F8" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBackground" Property="Background" Value="#171717" />
                                <Setter TargetName="ActionBackground" Property="BorderBrush" Value="#363636" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBackground" Property="Background" Value="#1A1A1A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PageLayout" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" MinHeight="76" MaxHeight="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ContentControl x:Name="FixedHeaderHost"
                        Grid.Row="0"
                        MinHeight="76"
                        MaxHeight="76"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Top"
                        Visibility="Visible" />

        <Grid Grid.Row="1" Background="#090909">
            <Grid.RowDefinitions>
                <RowDefinition Height="84" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="52,23,52,0"
                  VerticalAlignment="Top"
                  TextElement.FontFamily="Rajdhani"
                  TextElement.FontSize="17"
                  TextElement.FontWeight="SemiBold">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <TextBlock Text="Sort by"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="#9C9C9C" />
                    <ComboBox x:Name="SortByCombo"
                              Width="164"
                              Height="38"
                              MaxDropDownHeight="464"
                              Style="{StaticResource LibraryToolbarComboBox}"
                              IsTextSearchEnabled="False">
                        <ComboBoxItem Content="Title" Tag="Title" />
                        <ComboBoxItem Content="Time Played" Tag="TimePlayed" />
                        <ComboBoxItem Content="Longest Completion" Tag="LongestCompletion" />
                    </ComboBox>
                    <CheckBox x:Name="ShowOnlyPlayedToggle"
                              Margin="32,0,0,0"
                              IsChecked="False"
                              Style="{StaticResource LibraryToolbarSwitch}" />
                    <TextBlock Text="Show only played games"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Foreground="#9C9C9C" />
                </StackPanel>

                <Button x:Name="UpdateDatabaseButton"
                        Content="Update Database"
                        Style="{StaticResource OsirisActionButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="OnUpdateDatabaseClick" />
            </Grid>

            <Border Grid.Row="1"
                    Margin="28,0,28,28"
                    Background="#090909"
                    BorderBrush="#242424"
                    BorderThickness="1"
                    CornerRadius="0"
                    ClipToBounds="True">
                <Grid Background="#090909">
                <DataGrid x:Name="GamesGrid"
                          ItemsSource="{Binding GamesView}"
                          AutoGenerateColumns="False"
                          AlternationCount="2"
                          Background="#090909"
                          BorderThickness="0"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          CellStyle="{StaticResource LibraryCell}"
                          ColumnHeaderStyle="{StaticResource LibraryColumnHeader}"
                          EnableColumnVirtualization="True"
                          EnableRowVirtualization="True"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          HorizontalGridLinesBrush="Transparent"
                          HorizontalScrollBarVisibility="Disabled"
                          IsReadOnly="True"
                          RowHeaderWidth="0"
                          RowStyle="{StaticResource LibraryRow}"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ICON"
                                                Width="78"
                                                CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Width="44" Height="44">
                                        <Image Source="{Binding FallbackIconPath}"
                                               Width="36"
                                               Height="36"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Image Source="{Binding IconPath}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="GAME"
                                                Width="270"
                                                MinWidth="185"
                                                SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <Button Style="{StaticResource GameTitleButton}"
                                                Click="OnGameTitleClick">
                                            <TextBlock Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontFamily="Rajdhani"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                        <TextBlock Margin="0,3,0,0"
                                                   FontFamily="Rajdhani"
                                                   FontWeight="SemiBold">
                                            <Run Text="Time Played&#xA0;"
                                                 FontSize="15"
                                                 Foreground="#777A82" />
                                            <Run Text="{Binding PlayedTimeText, Mode=OneWay}"
                                                 FontSize="16"
                                                 Foreground="#F0F1F7" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="HOW LONG TO BEAT"
                                                Width="*"
                                                MinWidth="470"
                                                SortMemberPath="LongestTimeSeconds">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <local:HowLongToBeatTimeline PlayedSeconds="{Binding PlayedSeconds}"
                                                                       MainStorySeconds="{Binding MainStorySeconds}"
                                                                       MainExtraSeconds="{Binding MainExtraSeconds}"
                                                                       CompletionistSeconds="{Binding CompletionistSeconds}"
                                                                       TimeProfile="{Binding TimeProfile}"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding HasTimes, Converter={StaticResource BooleanToVisibility}}" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Rajdhani"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#777A82">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasTimes}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                    <Border x:Name="HeaderGutterFill"
                            Panel.ZIndex="10"
                            Width="0"
                            Height="44"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#111111"
                            BorderBrush="#242424"
                            BorderThickness="0,0,0,1"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
