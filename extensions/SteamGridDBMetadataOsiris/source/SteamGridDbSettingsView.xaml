<UserControl x:Class="Osiris.Extensions.SteamGridDBMetadata.SteamGridDbSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <StackPanel Width="760"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
        <CheckBox Content="Allow adult content artwork"
                  IsChecked="{Binding Settings.AllowAdultContentArtwork}" />
        <CheckBox Content="Allow humorous artwork"
                  IsChecked="{Binding Settings.AllowHumorousArtwork}" />
        <ComboBox SelectedValue="{Binding Settings.SimilarMediaApplication}"
                  SelectedValuePath="Tag">
            <ComboBoxItem Content="Different media" Tag="Different" />
            <ComboBoxItem Content="Same media" Tag="Same" />
        </ComboBox>
        <TextBox x:Name="AccountAccessCode"
                 Text="{Binding Settings.ApiKey, UpdateSourceTrigger=PropertyChanged}" />
        <Button Content="Get API key"
                Command="{Binding LoginCommand}" />
    </StackPanel>
</UserControl>
