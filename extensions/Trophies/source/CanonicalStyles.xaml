<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<!-- Canonical Backup styles copied exactly: extension resources cannot resolve the settings page's local scope.
Fields adapt Backup's editable path segment to TextBox/PasswordBox without its Browse button. -->
<FontFamily x:Key="FontFamily">Rajdhani</FontFamily>
<Style x:Key="OsirisSettingsTitleStyle" TargetType="{x:Type TextBlock}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Foreground" Value="#F0F1F7" /><Setter Property="FontFamily" Value="{DynamicResource FontFamily}" /><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="TextAlignment" Value="Left" /><Setter Property="Margin" Value="0,0,0,0" /></Style>
<Style x:Key="OsirisSettingsDescriptionStyle" TargetType="{x:Type TextBlock}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Foreground" Value="#777A82" /><Setter Property="FontFamily" Value="{DynamicResource FontFamily}" /><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="TextAlignment" Value="Left" /><Setter Property="Margin" Value="0,5,0,34" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
<Style x:Key="OsirisSettingsLabelStyle" TargetType="{x:Type TextBlock}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Foreground" Value="#F0F1F7" /><Setter Property="FontFamily" Value="{DynamicResource FontFamily}" /><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
<Style x:Key="OsirisSettingsHintStyle" TargetType="{x:Type TextBlock}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Foreground" Value="#777A82" /><Setter Property="FontFamily" Value="{DynamicResource FontFamily}" /><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
<Style x:Key="OsirisSettingsActionButtonStyle" TargetType="{x:Type Button}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Height" Value="38" /><Setter Property="Padding" Value="18,0" /><Setter Property="Background" Value="#111111" /><Setter Property="BorderBrush" Value="#252525" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Focusable" Value="False" /><Setter Property="Foreground" Value="#F3F4F8" /><Setter Property="FontFamily" Value="{DynamicResource FontFamily}" /><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}"><Border x:Name="ActionBackground" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionBackground" Property="Background" Value="#171717" /><Setter TargetName="ActionBackground" Property="BorderBrush" Value="#363636" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionBackground" Property="Background" Value="#1A1A1A" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="OsirisSettingsToggleStyle" TargetType="{x:Type CheckBox}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Width" Value="44" /><Setter Property="Height" Value="24" /><Setter Property="Cursor" Value="Hand" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type CheckBox}"><Grid Width="44" Height="24" Background="Transparent"><Border x:Name="ToggleTrack" Background="Transparent" BorderBrush="#34363D" BorderThickness="1" CornerRadius="12" /><Ellipse x:Name="ToggleThumb" Width="18" Height="18" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#9EA0A6" /></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#555860" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleTrack" Property="Background" Value="#1B1B1B" /><Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#666666" /><Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="ToggleThumb" Property="Fill" Value="#F7F8FA" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="OsirisSettingsToggleLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource OsirisSettingsLabelStyle}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Margin" Value="8,0,0,0" /></Style>
<Style x:Key="TrophiesTextBoxStyle" TargetType="{x:Type TextBox}"><Setter Property="Width" Value="388"/><Setter Property="Height" Value="40"/><Setter Property="Background" Value="#111111"/><Setter Property="BorderBrush" Value="#292929"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#A5A8AF"/><Setter Property="CaretBrush" Value="#F0F1F7"/><Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="13,0"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type TextBox}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="TrophiesPasswordBoxStyle" TargetType="{x:Type PasswordBox}"><Setter Property="Width" Value="388"/><Setter Property="Height" Value="40"/><Setter Property="Background" Value="#111111"/><Setter Property="BorderBrush" Value="#292929"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#A5A8AF"/><Setter Property="CaretBrush" Value="#F0F1F7"/><Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="13,0"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type PasswordBox}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="OsirisSettingsOutlinedComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Setter Property="Width" Value="190" /><Setter Property="Height" Value="38" /><Setter Property="Background" Value="#090909" /><Setter Property="BorderBrush" Value="#252525" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#A6A6A6" /><Setter Property="FontFamily" Value="{DynamicResource FontFamily}" /><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="Foreground" Value="#A6A6A6" /><Setter Property="FontFamily" Value="{DynamicResource FontFamily}" /><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /></Style></Setter.Value></Setter><Setter Property="Padding" Value="14,0,34,0" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ComboBox}"><Grid><Border x:Name="FieldBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" /><ToggleButton Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="{x:Type ToggleButton}"><Border Background="Transparent"><TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="#777B84" Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Center" /></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="14,0,34,0" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" RecognizesAccessKey="True" /><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" Focusable="False" AllowsTransparency="True"><Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"><Border Style="{DynamicResource PopupBorder}" /><ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="8"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer></Grid></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="#3A3A3A" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="Transparent" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
