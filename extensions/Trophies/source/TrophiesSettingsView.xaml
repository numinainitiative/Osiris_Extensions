<UserControl x:Class="Osiris.Extensions.Trophies.TrophiesSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CanonicalStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <TabControl x:Name="SettingsPages">
  <TabItem x:Name="GeneralPage" Header="General"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Width="760" HorizontalAlignment="Left">
   <Grid Height="54"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox x:Name="ShowCardsSwitch" IsChecked="{Binding Enabled}" Style="{StaticResource OsirisSettingsToggleStyle}"/><TextBlock Grid.Column="1" Text="Show Trophies cards on Game Details" Style="{StaticResource OsirisSettingsToggleLabelStyle}"/></Grid>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem x:Name="AccountPage" Header="Account"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Width="760" HorizontalAlignment="Left">
   <Grid Height="54"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Steam Web API Key" Style="{StaticResource OsirisSettingsLabelStyle}"/><PasswordBox Grid.Column="2" x:Name="ApiKeyBox" Style="{StaticResource TrophiesPasswordBoxStyle}" PasswordChanged="KeyChanged"/></Grid>
   <TextBlock x:Name="ApiKeyDescription" Text="Your Steam API Key is used to export trophies catalogues to Osiris games, it is not used to synchronise your unlocked trophies, this get updated through integrated libraries and optionally through our Exophase extension" MaxWidth="720" HorizontalAlignment="Left" Margin="0,12,0,24" Style="{StaticResource OsirisSettingsHintStyle}"/>
  </StackPanel></ScrollViewer></TabItem>
 </TabControl>
</UserControl>
