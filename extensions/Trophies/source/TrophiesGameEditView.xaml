<UserControl x:Class="Osiris.Extensions.Trophies.TrophiesGameEditView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CanonicalStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <StackPanel Width="760" HorizontalAlignment="Left" Margin="40,31,26,26">
  <TextBlock Text="Trophies" Style="{StaticResource OsirisSettingsTitleStyle}"/>
  <TextBlock x:Name="SyncHint" MaxWidth="720" Style="{StaticResource OsirisSettingsDescriptionStyle}"/>
  <Button x:Name="SyncButton" Content="Sync" HorizontalAlignment="Left" Margin="0,12,0,12" Click="SyncClick" Style="{StaticResource OsirisSettingsActionButtonStyle}"/>
  <TextBlock x:Name="SyncStatus" MaxWidth="720" Style="{StaticResource OsirisSettingsHintStyle}"/>
  <TextBlock Text="Achievement catalogue" Margin="0,24,0,0" Style="{StaticResource OsirisSettingsTitleStyle}"/>
  <TextBlock x:Name="StatusText" MaxWidth="720" Margin="0,6,0,12" Style="{StaticResource OsirisSettingsHintStyle}"/>
  <Grid Height="54"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <TextBlock Text="Steam App ID" Style="{StaticResource OsirisSettingsLabelStyle}"/>
   <TextBox Grid.Column="2" x:Name="AppIdBox" Style="{StaticResource TrophiesTextBoxStyle}"/>
  </Grid>
  <Button x:Name="ImportButton" Content="Fetch catalogue" HorizontalAlignment="Left" Margin="0,12,0,12" Click="ImportClick" Style="{StaticResource OsirisSettingsActionButtonStyle}"/>
  <TextBlock Text="Only needed to set up or replace the catalogue. Save applies catalogue changes." MaxWidth="720" Style="{StaticResource OsirisSettingsHintStyle}"/>
 </StackPanel>
</UserControl>
