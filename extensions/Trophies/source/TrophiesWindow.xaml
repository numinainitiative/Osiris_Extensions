<Window x:Class="Osiris.Extensions.Trophies.TrophiesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Trophies" Width="1225" Height="900" MinWidth="760" MinHeight="480" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="#050505" BorderThickness="0" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CanonicalStyles.xaml"/><ResourceDictionary Source="AchievementStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="WindowControl" TargetType="Button"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="48"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1C1C1C"/></Trigger></Style.Triggers></Style>
  <Style x:Key="CloseControl" TargetType="Button" BasedOn="{StaticResource WindowControl}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C"/></Trigger></Style.Triggers></Style>
 </ResourceDictionary></Window.Resources>
 <Grid ClipToBounds="True">
  <Border Background="#050505" CornerRadius="6" Margin="2"><Grid><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid><TextBlock x:Name="Heading" Text="Trophies" Margin="156,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F0F1F7" FontFamily="Rajdhani" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Style="{StaticResource WindowControl}" Click="MinimizeClick" ToolTip="Minimize"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M4,12 L20,12" Stroke="#C8CBD2" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button>
     <Button Style="{StaticResource WindowControl}" Click="MaximizeClick" ToolTip="Maximize / Restore"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M5,3 L19,3 Q21,3 21,5 L21,19 Q21,21 19,21 L5,21 Q3,21 3,19 L3,5 Q3,3 5,3 Z" Stroke="#C8CBD2" StrokeThickness="2" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
     <Button Style="{StaticResource CloseControl}" Click="CloseClick" ToolTip="Close"><Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="#C8CBD2" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button>
    </StackPanel>
   </Grid>
   <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0"><TextBlock Text="Sort by" Style="{StaticResource OsirisSettingsLabelStyle}"/><ComboBox x:Name="SortBy" Margin="18,0,0,0" Style="{StaticResource OsirisSettingsOutlinedComboBoxStyle}" Cursor="Hand" SelectedIndex="0" SelectionChanged="SortChanged"><ComboBoxItem Content="Title"/><ComboBoxItem Content="Rarity"/><ComboBoxItem Content="Last achieved"/></ComboBox></StackPanel>
   <ScrollViewer x:Name="AchievementScroll" Grid.Row="2" Margin="0,12,0,2" Padding="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="AllTrophies" Margin="24,0,24,22" Style="{StaticResource AchievementList}"/></ScrollViewer>
  </Grid></Border>
  <Border BorderBrush="#474747" BorderThickness="1.5" CornerRadius="8" Margin="0.5" IsHitTestVisible="False"/>
 </Grid>
</Window>
