<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Osiris.Extensions.Trophies">
 <local:TrophyIconConverter x:Key="TrophyIcon"/>
 <Style x:Key="AchievementIconShine" TargetType="Border">
  <Setter Property="Visibility" Value="Collapsed"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="IsHitTestVisible" Value="False"/>
  <Style.Triggers>
   <DataTrigger Binding="{Binding Highlight}" Value="{x:Static local:TrophyHighlight.Purple}">
    <Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="#644877"/><Setter Property="BorderBrush" Value="#9874C2"/>
    <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#A37ACC" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/></Setter.Value></Setter>
   </DataTrigger>
   <DataTrigger Binding="{Binding Highlight}" Value="{x:Static local:TrophyHighlight.Grey}">
    <Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="#363B41"/><Setter Property="BorderBrush" Value="#60656C"/>
    <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#8D9299" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/></Setter.Value></Setter>
   </DataTrigger>
   <DataTrigger Binding="{Binding Highlight}" Value="{x:Static local:TrophyHighlight.Gold}">
    <Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="#78642F"/><Setter Property="BorderBrush" Value="#AE934A"/>
    <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#D1AE59" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/></Setter.Value></Setter>
   </DataTrigger>
   <DataTrigger Binding="{Binding Highlight}" Value="{x:Static local:TrophyHighlight.Silver}">
    <Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="#79818B"/><Setter Property="BorderBrush" Value="#AFB9C5"/>
    <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#C2CDD9" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/></Setter.Value></Setter>
   </DataTrigger>
  </Style.Triggers>
 </Style>
 <DataTemplate x:Key="AchievementCategory"><TextBlock Text="{Binding Name}" Foreground="#626262" FontFamily="Rajdhani" FontSize="17" FontWeight="SemiBold" Margin="12,12,12,8"/></DataTemplate>
 <DataTemplate x:Key="AchievementRow"><Button Command="{Binding RevealCommand}" HorizontalContentAlignment="Stretch" BorderThickness="0" Padding="0" Margin="0,0,0,6">
  <Button.Style><Style TargetType="Button"><Setter Property="Cursor" Value="Arrow"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter HorizontalAlignment="Stretch"/></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding CanReveal}" Value="True"><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="True"/></DataTrigger></Style.Triggers></Style></Button.Style>
  <Border Padding="12" Background="#090909" HorizontalAlignment="Stretch">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Width="80" Height="80" VerticalAlignment="Top">
    <Border x:Name="IconShine" Style="{StaticResource AchievementIconShine}"/>
    <Border Margin="1" Background="#111111" CornerRadius="5"><Image Source="{Binding Trophy, Converter={StaticResource TrophyIcon}}" Width="72" Height="72" Stretch="Uniform"/></Border>
   </Grid>
   <StackPanel Grid.Column="2" VerticalAlignment="Center">
    <DockPanel>
     <TextBlock DockPanel.Dock="Right" Text="{Binding RarityText}" Foreground="#777A82" FontFamily="Rajdhani" FontSize="17" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Percentage of Steam players who earned this achievement"/>
     <WrapPanel VerticalAlignment="Center">
      <TextBlock Text="{Binding Name}" Foreground="#F2F2F2" FontFamily="Rajdhani" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding UnlockDateText}" Foreground="#777A82" FontFamily="Rajdhani" FontSize="21" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding UnlockDateText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBlock Text="{Binding PlatformText}" Foreground="#777A82" FontFamily="Rajdhani" FontSize="21" Margin="14,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding PlatformText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </WrapPanel>
    </DockPanel>
    <TextBlock Text="{Binding DisplayDescription}" Foreground="#777A82" FontFamily="Rajdhani" FontSize="17" Margin="0,4,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </Grid></Border></Button></DataTemplate>
 <Style x:Key="AchievementList" TargetType="ItemsControl">
  <Setter Property="Margin" Value="0"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="ItemTemplate" Value="{StaticResource AchievementRow}"/>
  <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel HorizontalAlignment="Stretch"/></ItemsPanelTemplate></Setter.Value></Setter>
  <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style></Setter.Value></Setter>
 </Style>
 <!-- Details view-more footer appearance, adapted from ToggleButton to Button. -->
 <Style x:Key="AchievementViewAll" TargetType="Button">
  <Setter Property="Height" Value="42"/><Setter Property="Content" Value="view all"/><Setter Property="Foreground" Value="#626262"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Rajdhani"/><Setter Property="FontSize" Value="17"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0,0,12,12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border></ControlTemplate></Setter.Value></Setter>
  <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#8A8A8A"/><Setter Property="Background" Value="#111111"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#151515"/></Trigger></Style.Triggers>
 </Style>
</ResourceDictionary>
