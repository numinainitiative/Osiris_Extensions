<UserControl x:Class="Osiris.Extensions.Stats.StatsGlobalPageControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#070707" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <UserControl.Resources>
    <Style x:Key="LibraryStatValueStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontFamily" Value="Rajdhani" />
      <Setter Property="FontSize" Value="36" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#F2F2F2" />
    </Style>
    <Style x:Key="LibraryStatLabelStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontFamily" Value="Rajdhani" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#626262" />
    </Style>
    <Style x:Key="LibraryHighlightValueStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="Margin" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="FontFamily" Value="Rajdhani" />
      <Setter Property="FontSize" Value="23" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#F2F2F2" />
    </Style>
    <Style x:Key="LibraryStatCardControlStyle" TargetType="{x:Type ContentControl}">
      <Setter Property="Height" Value="157" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ContentControl}">
            <Border Padding="8" Background="#070707" BorderBrush="#282828" BorderThickness="1" CornerRadius="20">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="93" />
                  <RowDefinition Height="7" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#111111" CornerRadius="12,12,3,3">
                  <Viewbox Margin="11" Stretch="Uniform" StretchDirection="DownOnly">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Viewbox>
                </Border>
                <Border Grid.Row="2" Background="#0B0B0B" CornerRadius="3,3,12,12">
                  <Viewbox Margin="8,2" Stretch="Uniform" StretchDirection="DownOnly">
                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource LibraryStatLabelStyle}" />
                  </Viewbox>
                </Border>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LibraryHighlightCardControlStyle" TargetType="{x:Type ContentControl}">
      <Setter Property="Height" Value="157" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ContentControl}">
            <Border Padding="8" Background="#070707" BorderBrush="#282828" BorderThickness="1" CornerRadius="20">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="93" />
                  <RowDefinition Height="7" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#111111" CornerRadius="12,12,3,3">
                  <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Border>
                <Border Grid.Row="2" Background="#0B0B0B" CornerRadius="3,3,12,12">
                  <Viewbox Margin="8,2" Stretch="Uniform" StretchDirection="DownOnly">
                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource LibraryStatLabelStyle}" />
                  </Viewbox>
                </Border>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LibraryListCardStyle" TargetType="{x:Type Border}">
      <Setter Property="Width" Value="482" />
      <Setter Property="Height" Value="503" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Background" Value="#070707" />
      <Setter Property="BorderBrush" Value="#282828" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="20" />
    </Style>
    <Style x:Key="LibraryListHeaderStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="Rajdhani" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#626262" />
    </Style>
    <Style x:Key="LibraryListViewMoreStyle" TargetType="{x:Type Button}">
      <Setter Property="MinWidth" Value="84" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="Rajdhani" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#444444" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonBackground" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBackground" Property="Background" Value="#1A1A1A" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBackground" Property="Background" Value="#242424" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CategoryEditButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="Rajdhani" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#626262" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonBackground" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#777A82" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="#C8C8C8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FollowingStatsSectionHeaderStyle" TargetType="{x:Type Grid}">
      <Setter Property="Width" Value="1644" />
      <Setter Property="Margin" Value="0,42,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="StatsSectionToggleStyle" TargetType="{x:Type Button}">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ToggleBackground" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="6">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleBackground" Property="Opacity" Value="0.78" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ToggleBackground" Property="Opacity" Value="0.58" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="GameListRowTemplate">
      <Grid Height="82.6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Rank}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Rajdhani" FontSize="19" FontWeight="SemiBold" Foreground="#626262" />
        <Border Grid.Column="1" Width="52" Height="52" VerticalAlignment="Center" Background="#0B0B0B" ClipToBounds="True" CornerRadius="5">
          <Image Source="{Binding IconPath}" Stretch="Uniform" />
        </Border>
        <TextBlock Grid.Column="3" Text="{Binding Name}" Margin="0,0,16,0" VerticalAlignment="Center" FontFamily="Rajdhani" FontSize="20" FontWeight="SemiBold" Foreground="#F2F2F2" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        <TextBlock Grid.Column="4" Text="{Binding DetailText}" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Rajdhani" FontSize="20" FontWeight="SemiBold" Foreground="#C8C8C8" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="LibraryListRowTemplate">
      <Grid Height="82.6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Rank}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Rajdhani" FontSize="19" FontWeight="SemiBold" Foreground="#626262" />
        <Border Grid.Column="1" Width="52" Height="52" Padding="11" VerticalAlignment="Center" Background="#0B0B0B" BorderBrush="#C8C8C8" BorderThickness="1" ClipToBounds="True" CornerRadius="8">
          <Grid>
            <Viewbox Stretch="Uniform">
              <Path Data="{Binding IconGeometry}" Fill="#F0F1F7">
                <Path.Style>
                  <Style TargetType="{x:Type Path}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding UseOsirisLogo}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
            </Viewbox>
            <Rectangle Margin="-7" Fill="#F0F1F7">
              <Rectangle.OpacityMask>
                <ImageBrush ImageSource="/Osiris.Stats;component/Assets/osiris-logo.png" Stretch="Uniform" />
              </Rectangle.OpacityMask>
              <Rectangle.Style>
                <Style TargetType="{x:Type Rectangle}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding UseOsirisLogo}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Rectangle.Style>
            </Rectangle>
          </Grid>
        </Border>
        <TextBlock Grid.Column="3" Text="{Binding Name}" Margin="0,0,16,0" VerticalAlignment="Center" FontFamily="Rajdhani" FontSize="20" FontWeight="SemiBold" Foreground="#F2F2F2" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        <TextBlock Grid.Column="4" Text="{Binding DetailText}" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Rajdhani" FontSize="20" FontWeight="SemiBold" Foreground="#C8C8C8" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="PlatformListRowTemplate">
      <Grid Height="82.6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Rank}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Rajdhani" FontSize="19" FontWeight="SemiBold" Foreground="#626262" />
        <Border Grid.Column="1" Width="52" Height="52" Padding="11" VerticalAlignment="Center" Background="#0B0B0B" BorderBrush="#C8C8C8" BorderThickness="1" ClipToBounds="True" CornerRadius="8">
          <Grid>
            <Viewbox Stretch="Uniform">
              <Path Data="{Binding IconGeometry}" Fill="#F0F1F7">
                <Path.Style>
                  <Style TargetType="{x:Type Path}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding UseOsirisLogo}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
            </Viewbox>
            <Rectangle Margin="-7" Fill="#F0F1F7">
              <Rectangle.OpacityMask>
                <ImageBrush ImageSource="/Osiris.Stats;component/Assets/osiris-logo.png" Stretch="Uniform" />
              </Rectangle.OpacityMask>
              <Rectangle.Style>
                <Style TargetType="{x:Type Rectangle}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding UseOsirisLogo}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Rectangle.Style>
            </Rectangle>
          </Grid>
        </Border>
        <TextBlock Grid.Column="3" Text="{Binding Name}" Margin="0,0,16,0" VerticalAlignment="Center" FontFamily="Rajdhani" FontSize="20" FontWeight="SemiBold" Foreground="#F2F2F2" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        <TextBlock Grid.Column="4" Text="{Binding DetailText}" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Rajdhani" FontSize="20" FontWeight="SemiBold" Foreground="#C8C8C8" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="StatusListRowTemplate">
      <Grid Height="82.6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Rank}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Rajdhani" FontSize="19" FontWeight="SemiBold" Foreground="#626262" />
        <Border Grid.Column="1" Width="52" Height="52" Padding="11" VerticalAlignment="Center" Background="#0B0B0B" BorderBrush="#C8C8C8" BorderThickness="1" CornerRadius="8">
          <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
              <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Stroke="#F0F1F7" StrokeThickness="1.8" />
              <Path Data="M6,12 L10,16 L18,8" Stroke="#F0F1F7" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
          </Viewbox>
        </Border>
        <TextBlock Grid.Column="3" Text="{Binding Name}" Margin="0,0,16,0" VerticalAlignment="Center" FontFamily="Rajdhani" FontSize="20" FontWeight="SemiBold" Foreground="#F2F2F2" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        <TextBlock Grid.Column="4" Text="{Binding DetailText}" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Rajdhani" FontSize="20" FontWeight="SemiBold" Foreground="#C8C8C8" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid Background="#070707">
    <Grid.RowDefinitions>
      <RowDefinition Height="76" MinHeight="76" MaxHeight="76" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ContentControl x:Name="FixedHeaderHost" Grid.Row="0" MinHeight="76" MaxHeight="76" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Visibility="Visible" />
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
      <StackPanel Margin="48,56,48,48" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <Grid Width="1644" HorizontalAlignment="Left">
          <Button Style="{StaticResource StatsSectionToggleStyle}" Click="WeeklyStatsHeader_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Weekly Stats" VerticalAlignment="Center" FontFamily="Rajdhani" FontSize="22" FontWeight="SemiBold" Foreground="#F0F1F7" />
              <Viewbox x:Name="WeeklyExpandedChevron" Width="13" Height="8" Margin="11,1,0,0">
                <Path Data="M1,1 L6,6 L11,1" Stroke="#777A82" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Viewbox>
              <Viewbox x:Name="WeeklyCollapsedChevron" Width="8" Height="13" Margin="11,1,0,0" Visibility="Collapsed">
                <Path Data="M1,1 L6,6 L1,11" Stroke="#777A82" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Viewbox>
            </StackPanel>
          </Button>
          <Button x:Name="WeeklyEditButton"
                  Content="Edit"
                  Style="{StaticResource CategoryEditButtonStyle}"
                  Click="CategoryEditButton_Click" />
        </Grid>
        <Canvas x:Name="WeeklyStatsContent" Width="1644" Height="157" Margin="0,23,0,0" HorizontalAlignment="Left" Background="Transparent">
          <Border x:Name="WeeklyTimePlayedCard" Canvas.Left="0" Canvas.Top="0" Width="316" Height="157" Padding="8" Background="#070707" BorderBrush="#282828" BorderThickness="1" CornerRadius="20">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="93" />
                <RowDefinition Height="7" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#111111" CornerRadius="12,12,3,3">
                <Grid Margin="10,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="43*" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="57*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="WeeklyTimePlayedValue" Text="0hs" FontFamily="Rajdhani" FontSize="30" FontWeight="Bold" Foreground="#F2F2F2" />
                    <Viewbox Width="17" Height="17" Margin="7,0,0,0" VerticalAlignment="Center">
                      <Canvas Width="24" Height="24">
                        <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Stroke="#C8C8C8" StrokeThickness="2" />
                        <Path Data="M12 6 V12 L16 14" Stroke="#C8C8C8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      </Canvas>
                    </Viewbox>
                  </StackPanel>
                  <ItemsControl x:Name="WeeklyPlaytimeBars" Grid.Column="2" VerticalAlignment="Bottom">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="7" Rows="1" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="1,0" ToolTip="{Binding Duration}">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="13" />
                          </Grid.RowDefinitions>
                          <Border Grid.Row="0" Width="14" Height="56" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#292929" CornerRadius="3" />
                          <Border Grid.Row="0" Width="14" Height="{Binding Height}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="{Binding Fill}" CornerRadius="3" />
                          <TextBlock Grid.Row="1" Margin="0,1,0,0" HorizontalAlignment="Center" FontFamily="Rajdhani" FontSize="11" FontWeight="SemiBold" Foreground="#81858D" Text="{Binding Day}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>
              <Border Grid.Row="2" Background="#0B0B0B" CornerRadius="3,3,12,12">
                <TextBlock Text="TIME PLAYED" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource LibraryStatLabelStyle}" />
              </Border>
            </Grid>
          </Border>
          <ContentControl x:Name="WeeklyNewGamesCard" Tag="NEW GAMES" Canvas.Left="332" Canvas.Top="0" Width="150" Style="{StaticResource LibraryStatCardControlStyle}">
            <TextBlock x:Name="WeeklyNewGamesValue" Text="0" Style="{StaticResource LibraryStatValueStyle}" />
          </ContentControl>
          <ContentControl x:Name="WeeklyFavoriteTimeCard" Tag="FAVOURITE TIME TO PLAY" Canvas.Left="498" Canvas.Top="0" Width="316" Style="{StaticResource LibraryStatCardControlStyle}">
            <TextBlock x:Name="WeeklyFavoriteTimeValue" Text="—" Style="{StaticResource LibraryStatValueStyle}" />
          </ContentControl>
          <ContentControl x:Name="WeeklyAverageSessionCard" Tag="AVERAGE SESSION" Canvas.Left="830" Canvas.Top="0" Width="316" Style="{StaticResource LibraryStatCardControlStyle}">
            <TextBlock x:Name="WeeklyAverageSessionValue" Text="—" Style="{StaticResource LibraryStatValueStyle}" />
          </ContentControl>
          <ContentControl x:Name="WeeklyTrophiesEarnedCard" Tag="TROPHIES EARNED" Canvas.Left="1162" Canvas.Top="0" Width="150" Style="{StaticResource LibraryStatCardControlStyle}">
            <TextBlock x:Name="WeeklyTrophiesEarnedValue" Text="0" Style="{StaticResource LibraryStatValueStyle}" />
          </ContentControl>
          <ContentControl x:Name="WeeklyMostPlayedGameCard" Tag="MOST PLAYED GAME" Canvas.Left="1328" Canvas.Top="0" Width="316" Style="{StaticResource LibraryHighlightCardControlStyle}">
            <TextBlock x:Name="WeeklyMostPlayedGameValue" Text="—" Style="{StaticResource LibraryHighlightValueStyle}" />
          </ContentControl>
        </Canvas>
        <Grid Style="{StaticResource FollowingStatsSectionHeaderStyle}">
          <Button Style="{StaticResource StatsSectionToggleStyle}" Click="AllTimeStatsHeader_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="All Time Stats" VerticalAlignment="Center" FontFamily="Rajdhani" FontSize="22" FontWeight="SemiBold" Foreground="#F0F1F7" />
              <Viewbox x:Name="AllTimeExpandedChevron" Width="13" Height="8" Margin="11,1,0,0">
                <Path Data="M1,1 L6,6 L11,1" Stroke="#777A82" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Viewbox>
              <Viewbox x:Name="AllTimeCollapsedChevron" Width="8" Height="13" Margin="11,1,0,0" Visibility="Collapsed">
                <Path Data="M1,1 L6,6 L1,11" Stroke="#777A82" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Viewbox>
            </StackPanel>
          </Button>
          <Button x:Name="AllTimeEditButton"
                  Content="Edit"
                  Style="{StaticResource CategoryEditButtonStyle}"
                  Click="CategoryEditButton_Click" />
        </Grid>
        <Canvas x:Name="LayoutCanvas" Width="1644" Height="1541" Margin="0,23,0,0" HorizontalAlignment="Left" Background="Transparent">
          <ContentControl x:Name="OwnedGamesCard" Tag="OWNED GAMES" Canvas.Left="0" Canvas.Top="0" Width="150" Style="{StaticResource LibraryStatCardControlStyle}">
            <TextBlock x:Name="OwnedGamesValue" Text="0" Style="{StaticResource LibraryStatValueStyle}" />
          </ContentControl>
          <ContentControl x:Name="TimePlayedCard" Tag="TOTAL PLAYED TIME" Canvas.Left="166" Canvas.Top="0" Width="316" Style="{StaticResource LibraryStatCardControlStyle}">
            <TextBlock x:Name="TimePlayedValue" Text="0h 00m" Style="{StaticResource LibraryStatValueStyle}" />
          </ContentControl>
          <ContentControl x:Name="PlayedGamesCard" Tag="PLAYED GAMES" Canvas.Left="498" Canvas.Top="0" Width="150" Style="{StaticResource LibraryStatCardControlStyle}">
            <TextBlock x:Name="PlayedGamesValue" Text="0" Style="{StaticResource LibraryStatValueStyle}" />
          </ContentControl>
          <ContentControl x:Name="TotalPlayCountCard" Tag="TOTAL PLAY COUNT" Canvas.Left="664" Canvas.Top="0" Width="150" Style="{StaticResource LibraryStatCardControlStyle}">
            <TextBlock x:Name="TotalPlayCountValue" Text="0" Style="{StaticResource LibraryStatValueStyle}" />
          </ContentControl>
          <Border x:Name="TopPlayedGamesCard" Canvas.Left="830" Canvas.Top="0" Style="{StaticResource LibraryListCardStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="7" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#0B0B0B" CornerRadius="12,12,3,3">
                <Grid Margin="13,0,8,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="TOP PLAYED GAMES" Style="{StaticResource LibraryListHeaderStyle}" />
                  <Button Grid.Column="1" Content="VIEW MORE" Style="{StaticResource LibraryListViewMoreStyle}" Click="ViewMoreTopPlayedGames_Click" />
