<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Width="256" Height="256">
 <Grid Width="64" Height="64">
  <Border CornerRadius="10">
   <Border.Background>
    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
     <GradientStop Color="#38284F" Offset="0"/>
     <GradientStop Color="#765085" Offset="1"/>
    </LinearGradientBrush>
   </Border.Background>
  </Border>
  <Rectangle Width="46" Height="46" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center">
   <Rectangle.OpacityMask>
    <ImageBrush ImageSource="source/gallery-symbol.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
   </Rectangle.OpacityMask>
  </Rectangle>
 </Grid>
</Viewbox>
